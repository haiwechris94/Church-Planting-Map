# Church Planting Map - Frontend Environment Variables
# Copy this file to .env and update the values as needed

# =============================================================================
# API Configuration
# =============================================================================

# Backend API URL (required)
# Development: http://localhost:5000
# Production: https://your-api-domain.com
VITE_API_URL=http://localhost:5000

# API request timeout in milliseconds (default: 30000)
VITE_API_TIMEOUT=30000

# =============================================================================
# Feature Flags
# =============================================================================

# Enable Voronoi diagram visualization
VITE_ENABLE_VORONOI=true

# Enable coverage gaps analysis layer
VITE_ENABLE_COVERAGE_GAPS=true

# Enable statistics panel
VITE_ENABLE_STATISTICS=true

# =============================================================================
# Map Configuration
# =============================================================================

# Default map center (Cameroon)
VITE_MAP_DEFAULT_CENTER_LAT=5.9631
VITE_MAP_DEFAULT_CENTER_LNG=10.1591

# Default zoom level (1-18)
VITE_MAP_DEFAULT_ZOOM=8

# =============================================================================
# Authentication (Optional)
# =============================================================================

# JWT token expiry check interval in milliseconds
# VITE_AUTH_CHECK_INTERVAL=60000

# =============================================================================
# Analytics (Optional)
# =============================================================================

# Google Analytics tracking ID
# VITE_GA_TRACKING_ID=UA-XXXXXXXXX-X

# =============================================================================
# Debug Mode (Development Only)
# =============================================================================

# Enable debug logging
# VITE_DEBUG=true
