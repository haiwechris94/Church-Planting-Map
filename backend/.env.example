# ===========================================
# Church Planting Map API - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# MongoDB Connection String
# Local development: mongodb://localhost:27017/church-planting-map
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/church-planting-map

# ===========================================
# SERVER CONFIGURATION
# ===========================================

# Server port (default: 3000)
PORT=3000

# Node environment (development, production, test)
NODE_ENV=development

# ===========================================
# AUTHENTICATION
# ===========================================

# JWT Secret Key (use a strong, random string in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT Expiration (e.g., 1d, 7d, 30d)
JWT_EXPIRES_IN=7d

# ===========================================
# EMAIL CONFIGURATION (Password Recovery)
# ===========================================

# SMTP Server Settings
# For Gmail: smtp.gmail.com (use App Password, not regular password)
# For Outlook: smtp.office365.com
# For custom SMTP: your-smtp-server.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# SMTP Authentication
# For Gmail, create an App Password: https://myaccount.google.com/apppasswords
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email sender address (optional, defaults to SMTP_USER)
SMTP_FROM=noreply@churchplantingmap.com

# Frontend URL (used for password reset links)
# Development: http://localhost:5173
# Production: https://your-domain.com
FRONTEND_URL=http://localhost:5173

# ===========================================
# OPTIONAL CONFIGURATIONS
# ===========================================

# API Rate Limiting (requests per window)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# CORS Origin (comma-separated for multiple origins)
# CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Logging Level (error, warn, info, debug)
# LOG_LEVEL=info
